    "react-dom": "^18",
    "react-tailwindcss-select": "^1.8.5",
    "react-toastify": "^11.0.5",
    "sharp": "^0.33.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tw-elements": "^1.1.0",
    "tw-elements-react": "^1.0.0-alpha2",
    "zustand": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.7",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "autoprefixer": "^10.0.1",
