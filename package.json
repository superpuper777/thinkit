{
  "name": "thinkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "ws:serve": "ts-node --project tsconfig.server.json socket-server.ts",
