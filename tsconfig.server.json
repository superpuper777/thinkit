{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module":  "ES2020",//"commonjs",
    "outDir": "./dist",
    "noEmit": false,
    "moduleResolution": "node16",//"node", 
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["socket-server.ts"],
  "exclude": ["node_modules"]
}
